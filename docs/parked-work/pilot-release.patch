+++ b/scripts/release/audit-data.py
@@ -0,0 +1,102 @@
+"""Read-only data audit. JSON evidence is not redistribution approval.
+
+python scripts/release/audit-data.py --raw PATH --bible PATH --dictionary PATH --out NEW.json
+Inputs are optional individually; omitted inputs are explicitly reported unverified.
+No source text, definition text, personal study files, or absolute paths enter the report.
+"""
+import argparse
+from contextlib import closing
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sqlite3
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'scripts/data'))
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+bible = load_module('bible_builder', ROOT / 'scripts/data/build-bible.py')
+dictionary = load_module('dictionary_builder', ROOT / 'scripts/build-dictionary.py')
+
+
+def digest(path):
+    return bible.file_digest(path)
+
+
+def audit(raw=None, bible_path=None, dictionary_path=None):
+    lock = json.loads((ROOT / 'data/bible-sources.lock.json').read_text(encoding='utf-8-sig'))
+    review = json.loads((ROOT / 'distribution/evidence/source-review.json').read_text(encoding='utf-8-sig'))
+    locked = {r['file']: (r['bytes'], r['sha256']) for r in lock['inputs']}
+    reviewed = {r['file']: (r['bytes'], r['sha256']) for r in review['inputs']}
+    if len(reviewed) != len(review['inputs']) or reviewed != locked:
+        raise ValueError('Source review no longer matches the Bible input lock.')
+    if (review['dictionary']['sha256'], review['dictionary']['entriesSha256'], review['dictionary']['entries']) != (dictionary.SOURCE_SHA256, dictionary.ENTRIES_SHA256, dictionary.EXPECTED_ENTRIES):
+        raise ValueError('Source review no longer matches the dictionary builder.')
+    report = {'schemaVersion': 1, 'redistribution': 'unreviewed', 'sourceReviewSha256': digest(ROOT / 'distribution/evidence/source-review.json'), 'bibleLockSha256': digest(ROOT / 'data/bible-sources.lock.json'), 'inputs': {'status': 'not-supplied'}, 'bible': {'status': 'not-supplied'}, 'dictionary': {'status': 'not-supplied'}}
+    if raw is not None:
+        bible.verify_inputs(raw, lock['inputs'])
+        report['inputs'] = {'status': 'verified', 'files': lock['inputs']}
+    if bible_path is not None:
+        bible_path = bible_path.resolve(strict=True)
+        bible.verify_database(bible_path, lock['tables'])
+        # Reject unexpected tables: the artifact must not contain added personal
+        # data or a source omitted from the reviewed schema.
+        with closing(sqlite3.connect(bible_path.as_uri() + '?mode=ro', uri=True)) as conn:
+            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
+        if tables != set(lock['tables']):
+            raise ValueError('Bible database has unexpected tables.')
+        report['bible'] = {'status': 'verified', 'bytes': bible_path.stat().st_size, 'sha256': digest(bible_path), 'schemaVersion': bible.SCHEMA_VERSION, 'tables': lock['tables']}
+    if dictionary_path is not None:
+        dictionary_path = dictionary_path.resolve(strict=True)
+        with closing(sqlite3.connect(dictionary_path.as_uri() + '?mode=ro', uri=True)) as conn:
+            if conn.execute('PRAGMA quick_check').fetchall() != [('ok',)]:
+                raise ValueError('Dictionary failed SQLite integrity check.')
+            if conn.execute('PRAGMA user_version').fetchone() != (1,):
+                raise ValueError('Dictionary schema is not the direct-source build schema.')
+            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
+            if tables != {'meta', 'entries'}:
+                raise ValueError('Dictionary database has unexpected tables.')
+            meta = dict(conn.execute('SELECT key,value FROM meta'))
+            if meta != dictionary.META:
+                raise ValueError('Dictionary metadata does not match the reviewed direct source.')
+            entries = dict(conn.execute('SELECT headword,text FROM entries ORDER BY headword'))
+            if len(entries) != dictionary.EXPECTED_ENTRIES or dictionary.entries_digest(entries) != dictionary.ENTRIES_SHA256:
+                raise ValueError('Dictionary entries differ from the reviewed fingerprint.')
+        report['dictionary'] = {'status': 'verified', 'bytes': dictionary_path.stat().st_size, 'sha256': digest(dictionary_path), 'schemaVersion': 1, 'entries': len(entries), 'entriesSha256': dictionary.ENTRIES_SHA256, 'sourceSha256': dictionary.SOURCE_SHA256}
+    report['bundledExportFonts'] = [{'path': p.relative_to(ROOT).as_posix(), 'bytes': p.stat().st_size, 'sha256': digest(p)} for p in sorted((ROOT / 'crates/wb-core/fonts').iterdir()) if p.suffix == '.woff' or p.name.startswith('LICENSE-')]
+    report['openReleaseConditions'] = review['openReleaseConditions']
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--raw', type=Path)
+    parser.add_argument('--bible', type=Path)
+    parser.add_argument('--dictionary', type=Path)
+    parser.add_argument('--out', type=Path)
+    args = parser.parse_args()
+    try:
+        value = audit(args.raw, args.bible, args.dictionary)
+        text = json.dumps(value, indent=2, ensure_ascii=False) + '\n'
+        if args.out:
+            with args.out.open('x', encoding='utf-8') as stream:
+                stream.write(text)
+            print(f'Wrote read-only audit evidence to {args.out}; redistribution remains unreviewed.')
+        else:
+            print(text, end='')
+    except (OSError, ValueError, KeyError, sqlite3.Error) as exc:
+        parser.exit(1, f'Data audit failed: {exc}\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/release/check.mjs b/scripts/release/check.mjs
new file mode 100644
index 0000000..80479a3
--- /dev/null
+++ b/scripts/release/check.mjs
@@ -0,0 +1,66 @@
+import { readFile, stat, realpath } from 'node:fs/promises';
+import { createReadStream } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { resolve, relative, isAbsolute, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parseRelease } from '../../distribution/release.mjs';
+
+export async function digest(path) {
+  const hash = createHash('sha256');
+  for await (const chunk of createReadStream(path)) hash.update(chunk);
+  return hash.digest('hex');
+}
+
+async function containedFile(root, name) {
+  if (typeof name !== 'string' || !name || isAbsolute(name)) throw new Error('Artifact path must be relative.');
+  const base = await realpath(root);
+  const path = await realpath(resolve(base, name));
+  const rel = relative(base, path);
+  if (!rel || rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) throw new Error(`Artifact escapes staging directory: ${name}`);
+  if (!(await stat(path)).isFile()) throw new Error(`Not a file: ${name}`);
+  return path;
+}
+
+// Read-only check. The manifest is supplied by the release operator, never inferred from personal files.
+export async function checkStaging(directory, expectedVersion) {
+  const manifest = JSON.parse(await readFile(resolve(directory, 'manifest.json'), 'utf8'));
+  if (manifest.schemaVersion !== 1 || manifest.version !== expectedVersion || manifest.target !== 'windows-x86_64') throw new Error('Staging version or target does not match the app.');
+  if (!Array.isArray(manifest.files)) throw new Error('Missing staging file inventory.');
+  const required = new Set(['app', 'cli', 'bible', 'dictionary', 'application-terms', 'third-party-notices']);
+  const names = new Set();
+  for (const item of manifest.files) {
+    if (!required.has(item.role) || names.has(item.role)) throw new Error(`Unknown or duplicate role: ${item.role}`);
+    names.add(item.role);
+    const file = await containedFile(directory, item.path);
+    if (!/^[a-f0-9]{64}$/.test(item.sha256) || await digest(file) !== item.sha256) throw new Error(`Hash mismatch: ${item.role}`);
+    if (!Number.isSafeInteger(item.bytes) || item.bytes <= 0 || (await stat(file)).size !== item.bytes) throw new Error(`Size mismatch: ${item.role}`);
+    if (['bible', 'dictionary'].includes(item.role)) {
+      if (item.redistribution !== 'approved' || typeof item.source !== 'string' || !item.source.trim() || typeof item.resourceVersion !== 'string' || !item.resourceVersion.trim() || !Number.isSafeInteger(item.schemaVersion) || item.schemaVersion < 1) throw new Error(`Resource provenance not approved: ${item.role}`);
+      const evidence = await containedFile(directory, item.evidence);
+      if (!(await readFile(evidence, 'utf8')).trim()) throw new Error(`Empty redistribution evidence: ${item.role}`);
+    }
+  }
+  for (const role of required) if (!names.has(role)) throw new Error(`Missing packaged component: ${role}`);
+  return manifest;
+}
+
+async function main() {
+  const root = fileURLToPath(new URL('../../', import.meta.url));
+  const npmPackage = JSON.parse(await readFile(resolve(root, 'package.json'), 'utf8'));
+  const tauri = JSON.parse(await readFile(resolve(root, 'app/src-tauri/tauri.conf.json'), 'utf8'));
+  const cargo = await readFile(resolve(root, 'Cargo.toml'), 'utf8');
+  const workspaceSection = cargo.split('[workspace.package]')[1]?.split('\n[')[0];
+  const version = workspaceSection?.match(/^version\s*=\s*"([^"]+)"/m)?.[1];
+  if (!version || version !== tauri.version || version !== npmPackage.version) throw new Error('Cargo, Tauri and package versions differ.');
+  const publicRelease = parseRelease(JSON.parse(await readFile(resolve(root, 'site/public/release.json'), 'utf8')));
+  if (publicRelease.status === 'published' && publicRelease.version !== version) throw new Error('Website and app versions differ.');
+  console.log(`Version ${version}: Cargo, Tauri, and website metadata agree.`);
+  const args = process.argv.slice(2);
+  if (args.length !== 2 || args[0] !== '--staging') throw new Error('Packaging is not ready: supply --staging <directory> containing manifest.json and approved artifacts. See distribution/README.md.');
+  await checkStaging(resolve(args[1]), version);
+  console.log('Staged components and recorded provenance passed integrity checks. This does not verify legal rights, code signing, activation, or clean-machine behavior.');
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  main().catch(error => { console.error(error.message); process.exitCode = 1; });
+}
diff --git a/scripts/release/collect-notices.py b/scripts/release/collect-notices.py
new file mode 100644
index 0000000..9ca75e9
--- /dev/null
+++ b/scripts/release/collect-notices.py
@@ -0,0 +1,99 @@
+"""Collect local package license/notice texts and locked identities for review.
+
+python -B scripts/release/collect-notices.py --out NEW_DIRECTORY
+Requires cargo metadata and npm ci. Never downloads or approves redistribution.
+Includes build dependencies conservatively; excludes development-only graph edges.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def collect(output):
+    if output.exists():
+        raise FileExistsError('Choose a new notices directory.')
+    raw = subprocess.check_output(['cargo', 'metadata', '--format-version', '1', '--locked',
+                                   '--filter-platform', 'x86_64-pc-windows-msvc',
+                                   '--features', 'bible-workbench/distribution,wb-cli/distribution'], cwd=ROOT)
+    metadata = json.loads(raw)
+    packages = {p['id']: p for p in metadata['packages']}
+    nodes = {p['id']: p for p in metadata['resolve']['nodes']}
+    queue = [p['id'] for p in packages.values() if p['source'] is None and p['name'] in ['bible-workbench', 'wb-cli']]
+    seen = set()
+    while queue:
+        identifier = queue.pop()
+        if identifier in seen:
+            continue
+        seen.add(identifier)
+        for dep in nodes[identifier]['deps']:
+            if any(kind['kind'] != 'dev' for kind in dep['dep_kinds']):
+                queue.append(dep['pkg'])
+    output.mkdir(parents=True)
+    records = []
+
+    def capture(kind, name, version, license_name, source, directory, explicit=None, features=None):
+        directory = directory.resolve()
+        candidates = [p for p in directory.iterdir() if p.is_file() and re.match(r'(?i)^(licen[sc]e|copying|notice|copyright)([._-]|$)', p.name)]
+        for sub in ['licenses', 'LICENSES']:
+            folder = directory / sub
+            if folder.is_dir():
+                candidates.extend(p for p in folder.rglob('*') if p.is_file())
+        if explicit:
+            candidates.append(directory / explicit)
+        texts = []
+        for path in sorted(set(candidates)):
+            resolved = path.resolve(strict=True)
+            rel = resolved.relative_to(directory)
+            content = resolved.read_bytes()
+            destination = Path(kind) / (name.replace('/', '__') + '-' + version) / rel
+            target = output / destination
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(content)
+            texts.append({'path': destination.as_posix(), 'sha256': hashlib.sha256(content).hexdigest()})
+        records.append({'kind': kind, 'name': name, 'version': version, 'license': license_name or 'UNKNOWN', 'source': source, 'features': features or [], 'texts': texts, 'review': 'unreviewed' if texts and license_name else 'missing-license-evidence'})
+
+    for identifier in sorted(seen):
+        package = packages[identifier]
+        if package['source']:
+            capture('rust', package['name'], package['version'], package['license'], package['source'], Path(package['manifest_path']).parent, package.get('license_file'), nodes[identifier]['features'])
+    lock = json.loads((ROOT / 'package-lock.json').read_text(encoding='utf-8'))
+    for location, package in sorted(lock['packages'].items()):
+        if not location or package.get('dev'):
+            continue
+        folder = ROOT / location
+        manifest = json.loads((folder / 'package.json').read_text(encoding='utf-8'))
+        if manifest['version'] != package['version']:
+            raise ValueError('Installed npm package differs from lock.')
+        capture('javascript', manifest['name'], manifest['version'], manifest.get('license'), package.get('resolved'), folder)
+    fonts = ROOT / 'crates/wb-core/fonts'
+    for path in fonts.glob('LICENSE-*'):
+        target = output / 'export-fonts' / path.name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(path.read_bytes())
+    report = {'schemaVersion': 1, 'target': 'x86_64-pc-windows-msvc', 'features': ['distribution'], 'status': 'collected-not-approved', 'cargoLockSha256': hashlib.sha256((ROOT / 'Cargo.lock').read_bytes()).hexdigest(), 'npmLockSha256': hashlib.sha256((ROOT / 'package-lock.json').read_bytes()).hexdigest(), 'packages': records, 'openConditions': ['Review missing evidence and package-specific obligations.', 'Review Microsoft WebView2 offline runtime redistribution terms separately.', 'Review static and export font attribution and reserved names.', 'Build dependencies are conservatively included; this inventory is not a binary composition proof.']}
+    (output / 'inventory.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
+    sections = ['THIRD-PARTY NOTICES DRAFT - NOT RELEASE APPROVED',
+                'Generated from local package evidence. Resolve missing texts and review runtime/territory obligations before shipping.',
+                (ROOT / 'distribution/notices/data-notices.txt').read_text(encoding='utf-8')]
+    for record in records:
+        sections.append(f"{record['kind']}: {record['name']} {record['version']} - {record['license']}\nSource: {record['source']}")
+        if not record['texts']:
+            sections.append('MISSING ORIGINAL LICENSE/NOTICE TEXT - RELEASE REVIEW REQUIRED')
+        for item in record['texts']:
+            sections.append(item['path'] + '\n' + (output / item['path']).read_text(encoding='utf-8-sig'))
+    for path in sorted((output / 'export-fonts').glob('*')):
+        sections.append(path.name + '\n' + path.read_text(encoding='utf-8-sig'))
+    (output / 'third-party-notices.draft.txt').write_text('\n\n'.join(sections) + '\n', encoding='utf-8')
+    print(json.dumps({'packages': len(records), 'missingLicenseEvidence': sum(p['review'] == 'missing-license-evidence' for p in records), 'status': report['status']}))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', required=True, type=Path)
+    args = parser.parse_args()
+    collect(args.out)
diff --git a/scripts/release/issuer.mjs b/scripts/release/issuer.mjs
new file mode 100644
index 0000000..e150a33
--- /dev/null
+++ b/scripts/release/issuer.mjs
@@ -0,0 +1,79 @@
+// Operator-only manual pilot issuance. Never bundle this file or the encrypted issuer key.
+// JSON input comes from stdin so passphrases never enter command-line arguments.
+import { createPrivateKey, createPublicKey, generateKeyPairSync, sign, verify } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const product = 'app.bibleworkbench.desktop';
+const max = 32768;
+function identifier(value, name) {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(value)) throw new Error(`Invalid ${name}.`);
+  return value;
+}
+function envelope(text) {
+  if (typeof text !== 'string' || Buffer.byteLength(text) > max) throw new Error('Request is too large.');
+  const result = JSON.parse(text);
+  if (!result || Object.keys(result).sort().join(',') !== 'payload,signature') throw new Error('Invalid request envelope.');
+  for (const key of ['payload','signature']) {
+    if (typeof result[key] !== 'string' || !/^[A-Za-z0-9+/]*={0,2}$/.test(result[key])) throw new Error('Invalid base64 encoding.');
+    const decoded = Buffer.from(result[key], 'base64');
+    if (decoded.toString('base64') !== result[key]) throw new Error('Noncanonical base64 encoding.');
+    result[key] = decoded;
+  }
+  return result;
+}
+export function verifyRequest(text) {
+  const { payload, signature } = envelope(text);
+  const request = JSON.parse(payload.toString('utf8'));
+  if (Object.keys(request).sort().join(',') !== 'device_public_key,product_id,purpose,schema_version' || request.schema_version !== 1 || request.product_id !== product || request.purpose !== 'pilot-activation' || !/^[a-f0-9]{64}$/.test(request.device_public_key)) throw new Error('Unsupported activation request.');
+  const key = createPublicKey({ key: { kty: 'OKP', crv: 'Ed25519', x: Buffer.from(request.device_public_key,'hex').toString('base64url') }, format: 'jwk' });
+  if (signature.length !== 64 || !verify(null, payload, key, signature)) throw new Error('Device proof did not verify.');
+  return request;
+}
+
+export function issue(requestText, privateKey, { keyId, licenseId, activationId }) {
+  const request = verifyRequest(requestText);
+  if (privateKey.asymmetricKeyType !== 'ed25519') throw new Error('The issuer must use Ed25519.');
+  const certificate = {
+    schema_version: 1, product_id: product, issuer_key_id: identifier(keyId, 'key id'),
+    license_id: identifier(licenseId, 'license id'), activation_id: identifier(activationId, 'activation id'),
+    device_public_key: request.device_public_key, issued_at: new Date().toISOString(),
+    offline_use: 'permanent', features: ['pilot'],
+  };
+  const payload = Buffer.from(JSON.stringify(certificate));
+  return { certificate, envelope: { payload: payload.toString('base64'), signature: sign(null,payload,privateKey).toString('base64') } };
+}
+
+export async function operate(input) {
+  if (typeof input.passphrase !== 'string' || input.passphrase.length < 16) throw new Error('Supply an issuer-key passphrase of at least 16 characters through stdin.');
+  if (input.action === 'keygen') {
+    const keyId = identifier(input.keyId, 'key id');
+    const { privateKey, publicKey } = generateKeyPairSync('ed25519');
+    const encrypted = privateKey.export({ type: 'pkcs8', format: 'pem', cipher: 'aes-256-cbc', passphrase: input.passphrase });
+    await writeFile(input.privateKeyPath, encrypted, { flag: 'wx', mode: 0o600 });
+    const publicHex = Buffer.from(publicKey.export({ format: 'jwk' }).x, 'base64url').toString('hex');
+    await writeFile(input.publicKeyPath, JSON.stringify({ key_id: keyId, public_key: publicHex }, null, 2), { flag: 'wx' });
+    return { created: true, key_id: keyId, public_key: publicHex };
+  }
+  if (input.action !== 'issue') throw new Error('Unknown issuer action.');
+  const pem = await readFile(input.privateKeyPath, 'utf8');
+  if (!pem.startsWith('-----BEGIN ENCRYPTED PRIVATE KEY-----')) throw new Error('Only encrypted issuer keys are accepted.');
+  const key = createPrivateKey({ key: pem, passphrase: input.passphrase });
+  const request = await readFile(input.requestPath, 'utf8');
+  const result = issue(request, key, input);
+  // One immutable audit record per manually approved activation. No seat policy is invented here.
+  await writeFile(input.auditPath, JSON.stringify({ ...result.certificate, event: 'manual-pilot-authorized' }, null, 2), { flag: 'wx', mode: 0o600 });
+  await writeFile(input.outputPath, JSON.stringify(result.envelope, null, 2), { flag: 'wx' });
+  return { issued: true, license_id: result.certificate.license_id, activation_id: result.certificate.activation_id };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  (async () => {
+    if (process.stdin.isTTY) throw new Error('Provide issuer JSON through stdin from a secure operator tool. Never put passphrases in shell arguments.');
+    let text = '';
+    for await (const chunk of process.stdin) { text += chunk; if (Buffer.byteLength(text) > max) throw new Error('Issuer input too large.'); }
+    const result = await operate(JSON.parse(text));
+    process.stdout.write(JSON.stringify(result) + '\n');
+  })().catch(() => { console.error('Issuance failed. Check inputs, encrypted key, request proof, and unused output/audit paths. No secret details were logged.'); process.exitCode = 1; });
+}
diff --git a/scripts/release/prepare.mjs b/scripts/release/prepare.mjs
new file mode 100644
index 0000000..d6cc9cb
--- /dev/null
+++ b/scripts/release/prepare.mjs
@@ -0,0 +1,60 @@
+// Prepare an isolated installer overlay from an explicitly supplied, validated inventory.
+// No database download, source-data copying, build, signing, publication, or study writes.
+import { mkdir, mkdtemp, copyFile, writeFile, readFile } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { checkStaging, digest } from './check.mjs';
+
+export async function readCliBuildInfo(path) {
+  const { stdout } = await promisify(execFile)(path, ['build-info', '--json'], { timeout: 15000, maxBuffer: 16384, windowsHide: true });
+  return JSON.parse(stdout);
+}
+export async function prepare(staging, outputParent, version, trust = { key: process.env.WB_LICENSE_PUBLIC_KEY, id: process.env.WB_LICENSE_KEY_ID }, inspectCli = readCliBuildInfo) {
+  if (!/^[a-f0-9]{64}$/.test(trust?.key ?? '') || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(trust?.id ?? '')) throw new Error('Customer packaging requires public issuer trust.');
+  const manifest = await checkStaging(staging, version);
+  const cli = manifest.files.find(file => file.role === 'cli');
+  const info = await inspectCli(resolve(staging, cli.path));
+  if (info.version !== version || info.distribution !== true || info.issuer_key_id !== trust.id || info.issuer_public_key !== trust.key) throw new Error('Staged CLI must be a matching distribution build with the same public issuer trust.');
+  await mkdir(outputParent, { recursive: true });
+  const output = await mkdtemp(join(outputParent, 'bundle-'));
+  const mapping = { cli: 'wb.exe', bible: 'resources/workbench.db', dictionary: 'resources/dictionary.db', 'application-terms': 'notices/application-terms.txt', 'third-party-notices': 'notices/third-party-notices.txt' };
+  const resources = {};
+  const runtimeFiles = [];
+  for (const [role, name] of Object.entries(mapping)) {
+    const input = manifest.files.find(file => file.role === role);
+    const dest = resolve(output, name);
+    await mkdir(resolve(dest, '..'), { recursive: true });
+    await copyFile(resolve(staging, input.path), dest);
+    if (await digest(dest) !== input.sha256) throw new Error(`Staged file changed during preparation: ${role}`);
+    resources[dest] = name;
+    if (role === 'bible' || role === 'dictionary') runtimeFiles.push({ name: name.split('/').at(-1), bytes: input.bytes, sha256: input.sha256 });
+  }
+  const runtimeManifest = join(output, 'resources-manifest.json');
+  await writeFile(runtimeManifest, JSON.stringify({ schema_version: 1, app_version: version, files: runtimeFiles }, null, 2));
+  resources[runtimeManifest] = 'resources/resources-manifest.json';
+  const config = {
+    build: { features: ['distribution'] },
+    bundle: { active: true, targets: ['nsis'], resources,
+      windows: { nsis: { installMode: 'currentUser' }, webviewInstallMode: { type: 'offlineInstaller', silent: true } },
+    },
+  };
+  const configPath = join(output, 'tauri.distribution.json');
+  await writeFile(configPath, JSON.stringify(config, null, 2));
+  return configPath;
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  (async () => {
+    if (process.argv.length !== 4 || process.argv[2] !== '--staging') throw new Error('Usage: npm run release:prepare -- --staging <approved-staging-folder>');
+    if (!/^[a-f0-9]{64}$/.test(process.env.WB_LICENSE_PUBLIC_KEY ?? '') || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(process.env.WB_LICENSE_KEY_ID ?? '')) throw new Error('Set the public WB_LICENSE_PUBLIC_KEY and WB_LICENSE_KEY_ID build variables before preparing a customer package. Never supply the private key here.');
+    const root = fileURLToPath(new URL('../../', import.meta.url));
+    const { version } = JSON.parse(await readFile(join(root, 'app/src-tauri/tauri.conf.json'), 'utf8'));
+    const config = await prepare(resolve(process.argv[3]), join(root, 'release-staging'), version);
+    console.log(`Prepared installer overlay: ${config}`);
+    console.log('Build with: npm run tauri -- build --config "' + config + '"');
+    console.log('The supplied CLI must be built with --features distribution. This unsigned preparation is not a release; activation, signing, and clean-machine validation remain required.');
+    console.log('Keep the same public issuer build variables set when building both CLI and GUI.');
+  })().catch(error => { console.error(error.message); process.exitCode = 1; });
+}
diff --git a/scripts/release/smoke-cli.py b/scripts/release/smoke-cli.py
new file mode 100644
index 0000000..32134d7
--- /dev/null
+++ b/scripts/release/smoke-cli.py
@@ -0,0 +1,110 @@
+"""Native customer CLI smoke checks with synthetic resources and isolated Windows state.
+
+Usage: python scripts/release/smoke-cli.py --binary <distribution wb.exe>
+No production issuer, personal study, downloaded dataset or installed application is used.
+"""
+import argparse
+from contextlib import closing
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import sqlite3
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--binary', required=True, type=Path)
+    args = parser.parse_args()
+    binary = args.binary.resolve(strict=True)
+    with tempfile.TemporaryDirectory(prefix='wb-customer-cli-smoke-') as scratch:
+        base = Path(scratch)
+        install = base / 'app'
+        resources = install / 'resources'
+        resources.mkdir(parents=True)
+        exe = install / 'wb.exe'
+        shutil.copy2(binary, exe)
+        elsewhere = base / 'unrelated-working-directory'
+        elsewhere.mkdir()
+        env = dict(os.environ)
+        env['LOCALAPPDATA'] = str(base / 'local-app-data')
+        env['WB_BIBLE_DB'] = str(base / 'developer-database-must-not-be-used')
+        env['WB_DICT_DB'] = str(base / 'developer-dictionary-must-not-be-used')
+        env['WB_STUDY_DIR'] = str(base / 'developer-study-must-not-be-created')
+        env.pop('WB_ALLOW_REAL_STUDY', None)
+
+        def run(*argv, success=True, alternate_env=None):
+            result = subprocess.run([str(exe), *argv], cwd=elsewhere,
+                                    env=alternate_env or env, text=True, encoding='utf-8',
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
+            if (result.returncode == 0) != success:
+                raise AssertionError(f'{argv}: unexpected exit {result.returncode}: {result.stderr}')
+            return result.stdout
+
+        no_local = dict(env)
+        no_local.pop('LOCALAPPDATA', None)
+        info = json.loads(run('build-info', '--json', alternate_env=no_local))
+        assert info['distribution'] is True, 'Requires a distribution-feature binary'
+        assert isinstance(info['version'], str) and info['version']
+        assert 'issuer_public_key' in info and 'issuer_key_id' in info
+        assert not (base / 'local-app-data').exists(), 'build-info must be side-effect-free'
+
+        inventory = []
+        for name, schema in [
+            ('workbench.db', 'CREATE TABLE books (id INTEGER, code TEXT, name TEXT, testament TEXT, chapters INTEGER);'),
+            ('dictionary.db', 'CREATE TABLE meta (key TEXT, value TEXT); CREATE TABLE entries (headword TEXT, text TEXT);')
+        ]:
+            path = resources / name
+            with closing(sqlite3.connect(path)) as db:
+                db.executescript(schema)
+            content = path.read_bytes()
+            inventory.append({'name': name, 'bytes': len(content), 'sha256': hashlib.sha256(content).hexdigest()})
+        (resources / 'resources-manifest.json').write_text(json.dumps({
+            'schema_version': 1, 'app_version': info['version'], 'files': inventory
+        }), encoding='utf-8')
+        initial = json.loads(run('setup'))
+        assert initial['resources_ok'] and not initial['ready']
+        study = base / 'study'
