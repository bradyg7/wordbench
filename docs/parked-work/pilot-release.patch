+import '@fontsource/inter/latin-400.css';
+import '@fontsource/inter/latin-600.css';
+import '@fontsource/literata/latin-400.css';
+import '@fontsource/literata/latin-500.css';
+import './style.css';
+import { demoLibrary, demoTeaser, mountDemoLibrary } from './demo-library';
+import { parseRelease } from '../../distribution/release.mjs';
+
+const page = location.pathname.replace(/\/index\.html$/, '/').replace(/\/$/, '') || '/';
+if (page === '/' && /^#demo(?:-|$)/.test(location.hash)) location.replace(`/demos/${location.hash === '#demo' ? '' : location.hash}`);
+const links = [['/', 'Overview'], ['/demos/', 'Demo library'], ['/download/', 'Availability'], ['/releases/', 'Releases'], ['/support/', 'Help']];
+const titles: Record<string, string> = { '/': 'A place for your study.', '/demos': 'The demo library.', '/download': 'Get Bible Workbench.', '/releases': 'Follow the work.', '/support': 'Help with your workbench.', '/license': 'Your pilot license.', '/privacy': 'Your study stays yours.' };
+const title = titles[page] ?? 'Page not found.';
+document.title = `${page === '/' ? 'Personal Bible study' : title} — Bible Workbench`;
+
+const root = document.querySelector<HTMLElement>('#app')!;
+root.innerHTML = `
+  <a class="skip" href="#main">Skip to content</a>
+  <header class="wrap masthead"><a class="brand" href="/">Bible Workbench<span>PERSONAL STUDY, IN YOUR HANDS</span></a>
+    <nav aria-label="Main navigation">${links.map(([url, label]) => `<a href="${url}" ${page === (url.replace(/\/$/, '') || '/') ? 'aria-current="page"' : ''}>${label}</a>`).join('')}</nav>
+  </header>
+  <main id="main" class="wrap" tabindex="-1"><div class="eyebrow">WINDOWS DESKTOP · DEVELOPMENT PREVIEW</div><h1>${title}</h1><div id="content"></div></main>
+  <footer class="wrap"><p>Bible Workbench<span>A personal place to read, look closely, and keep your work.</span></p><nav aria-label="Footer"><a href="/license/">Pilot license</a><a href="/privacy/">Privacy</a><a href="/support/">Help</a></nav></footer>`;
+
+const content = document.querySelector<HTMLElement>('#content')!;
+const releasePanel = `<section class="release-panel" aria-labelledby="release-heading"><div><div class="eyebrow">WINDOWS · PRIVATE PILOT</div><h2 id="release-heading">Release availability</h2></div><div id="release" aria-live="polite"><p>Checking release availability…</p></div></section>`;
+const pages: Record<string, string> = {
+  '/': `<section class="intro"><p class="lead">Read the text. Explore its words.<br> Keep your own notes beside it.</p><div class="actions"><a class="button" href="/demos/">Explore the demos <span aria-hidden="true">↗</span></a><a class="text-link" href="/download/">Check availability →</a></div><p class="quiet">A closer look at the app in development. The Windows pilot is being prepared.</p></section>
+    <figure class="hero-preview"><div class="preview-label"><span class="preview-dot"></span> INSIDE BIBLE WORKBENCH <span>Development interface</span></div><a href="/demo/parallel-readers.png" target="_blank" rel="noopener" aria-label="Open full-size screenshot of two reading panes"><img src="/demo/parallel-readers.png" alt="Bible Workbench with Psalm 119 in the main reader and John 1 in a separate reading pane" width="1280" height="800" fetchpriority="high"></a><figcaption>Keep a passage in view while you read somewhere else.</figcaption></figure>
+    <section id="workbench" class="features" aria-label="Inside the workbench"><div class="section-heading"><span class="eyebrow">ONE WORKSPACE, YOUR OWN WORK</span><h2>Room to read.<br> Room to return.</h2></div><div class="feature-list"><article><span class="number">01</span><div><h3>Read and look closely</h3><p>The reader brings KJV and YLT text together with search, word lookups, and interlinear views.</p></div></article><article><span class="number">02</span><div><h3>Keep the connections</h3><p>Pages, highlights, and threads give your notes a place beside the passages you are studying.</p></div></article><article><span class="number">03</span><div><h3>Keep your files</h3><p>Your study uses local Markdown and JSON files. Your notes remain your own work, in your own folder.</p></div></article></div></section>
+    ${demoTeaser}
+    <section class="detail-showcase" aria-labelledby="lookup-title"><div><span class="eyebrow">LOOK CLOSER</span><h2 id="lookup-title">The source,<br> within reach.</h2><p>Open a word to see its original-language form, Strong’s number, lexical entry, and occurrence count. Return to the passage without losing your place.</p><a class="text-link" href="/demo/word-lookup.png" target="_blank" rel="noopener">View the full-size screenshot ↗</a></div><a class="detail-image" href="/demo/word-lookup.png" target="_blank" rel="noopener" aria-label="Open full-size word lookup screenshot"><img src="/demo/word-lookup.png" alt="A word lookup card showing its Greek form, Strong’s reference, lexical entry and occurrence counts, over the reading pane" width="1280" height="800" loading="lazy"></a></section>
+    <section class="ownership"><span class="eyebrow">BUILT FOR PERSONAL STUDY</span><h2>The sources in view.<br> The conclusions are yours.</h2><p>A workspace for source text, lookups, and the notes you write. The app does not supply doctrinal conclusions.</p></section>${releasePanel}`,
+  '/demos': demoLibrary,
+  '/download': `<p class="lead">The first release is a private Windows pilot.</p><p class="measure">Pilot licenses are issued manually. Once activated, a licensed copy can be used permanently offline. Each invited participant may activate two computers, and pilot updates are included. Pricing has not been set.</p>${releasePanel}<section class="prose"><h2>Install and activate</h2><ol><li>Use the download offered above when a pilot release is available. Compare its SHA-256 checksum with the listing.</li><li>Run the installer, then choose a new or existing study folder.</li><li>Create an activation request in the app and send it through the contact supplied with your pilot invitation.</li><li>Import the signed license file returned to you. The activated app can then be used offline.</li></ol><p>A download does not itself grant a license. <a href="/support/">Get installation and activation help.</a></p><h2>Using another platform?</h2><p>No macOS, Linux, iPhone, iPad, or Android release is available here yet.</p><a href="/license/">Read the pilot license policy →</a></section>`,
+  '/releases': `<p class="lead">Version details and release notes, in one place.</p>${releasePanel}<p class="measure">A development version number is not a released installer. Only published pilot builds will appear here.</p>`,
+  '/license': `<p class="lead">Manually issued. Permanently offline after activation.</p><section class="prose"><h2>The approved pilot approach</h2><p>The pilot uses manually issued licenses. After activation, a licensed copy does not need recurring online renewal to keep working.</p><h2>Computers and updates</h2><p>Each invited participant may activate two computers. When a computer is replaced, the pilot owner may issue a replacement activation. Pilot updates are included; an activated version remains usable permanently offline.</p><h2>Before distribution</h2><p>Pricing has not been set. Final application terms will be provided before distribution.</p><h2>Your own work remains yours</h2><p>Study files are separate from the installed app. Licensing must not encrypt or delete your notes, or prevent you from recovering your files.</p><h2>Release status</h2><p>Activation uses a request from the installed app and a signed license file returned by the pilot issuer. This website does not collect payments, activation requests, or license files.</p></section>`,
+  '/privacy': `<p class="lead">Local study files. Clear boundaries.</p><section class="prose"><h2>This public preview</h2><p>This preview is hosted with OpenAI Sites. It displays product information, screenshots, guided recordings, a searchable feature guide, and release availability. We have not added analytics, account creation, payments, email sign-up forms, or an app download service to this preview.</p><p>Your browser requests pages and media from the hosting service. That infrastructure may process ordinary request information under its own policies. See <a href="https://openai.com/policies/privacy-policy/" target="_blank" rel="noopener">OpenAI’s privacy policy</a>. This website does not access your computer’s study folder.</p><h2>The desktop design</h2><p>Notes and highlights live in your study folder. Manual activation sends the pilot issuer a public device key and proof of possession. It does not include your notes or a private device key. Keep your study content out of support messages. Any hosted download or update service must be covered by the final privacy notice before it is enabled.</p><h2>Before downloads or sign-ups open</h2><p>This notice will be updated for any added download, activation, contact, or sign-up service. No such service is enabled on this public preview.</p><h2>Demo sources</h2><p>The screenshots and recordings use a disposable sample workspace. Scripture shown in the interface comes from the read-only KJV database, supplied by <a href="https://ebible.org/eng-kjv2006/copyright.htm">eBible / CrossWire</a>. YLT text comes from the public-domain translation supplied by <a href="https://github.com/scrollmapper/bible_databases/blob/59b18c5af5845728c275d5b7178ad0d024172b1f/sources/en/YLT/README.md">scrollmapper/bible_databases</a>. The displayed Greek Strong’s entry comes from <a href="https://github.com/morphgnt/strongs-dictionary-xml">morphgnt/strongs-dictionary-xml</a> (CC0 1.0). No personal study files are published.</p><p>Website typography: <a href="/notices/inter-license.txt">Inter license</a> · <a href="/notices/literata-license.txt">Literata license</a>.</p></section>`,
+  '/support': `<p class="lead">Keep your study files safe and within reach.</p><section class="prose"><h2>About this preview</h2><p>This is a public look at an app in development. Public downloads, purchases, sign-ups, and a support inbox are not open yet. You can <a href="/demos/">browse the demo library</a> or <a href="/download/">check release availability</a>.</p><h2>For pilot participants</h2><p>Use the contact route included with your pilot invitation. If you lose access after reinstalling Windows or changing computers, ask that contact about reactivation. Copying a license file alone does not activate a different device identity.</p><h2>Recover your files</h2><p>Setup shows the selected study folder even before activation. You can copy its Markdown and JSON files with ordinary file tools. The installed CLI also reports the folder with <code>wb license recovery</code>.</p><h2>Damaged installation</h2><p>If the app reports missing or damaged resources, keep your study folder and reinstall the approved pilot package. Do not replace the bundled databases with files from an unknown source.</p><h2>Back up your study folder</h2><p>Keep a separate backup of your personal study files before installing an update. Your study folder is separate from the app installer.</p><h2>When reporting a problem</h2><p>Include the app version, Windows version, and what you were doing. Do not include a license key or private study content.</p><a href="/releases/">Check release availability →</a></section>`,
+};
+content.innerHTML = pages[page] ?? '<p>This page does not exist. <a href="/">Return to the overview.</a></p>';
+
+mountDemoLibrary();
+
+async function loadRelease() {
+  const panel = document.querySelector<HTMLElement>('#release');
+  if (!panel) return;
+  panel.textContent = 'Checking release availability…';
+  try {
+    const response = await fetch('/release.json', { cache: 'no-store', signal: AbortSignal.timeout(10000) });
+    if (!response.ok) throw new Error('Release information unavailable.');
+    const release = parseRelease(await response.json());
+    if (release.status === 'unavailable') {
+      panel.innerHTML = '<h3>Not available yet</h3><p>The pilot installer is being prepared. No download or purchase is available at this time.</p>';
+      return;
+    }
+    const heading = document.createElement('h3');
+    heading.textContent = `Version ${release.version}`;
+    const detail = document.createElement('p');
+    detail.textContent = `Windows ${release.minimumWindows} · x86_64 · ${(release.bytes / 1048576).toFixed(1)} MB · ${release.publishedAt.slice(0, 10)}`;
+    const notes = document.createElement('p');
+    notes.className = 'release-notes'; notes.textContent = release.notes;
+    const download = document.createElement('a');
+    download.className = 'button'; download.href = release.downloadPath; download.textContent = 'Download for Windows';
+    const access = document.createElement('p');
+    access.textContent = 'For invited pilot participants. If download access fails, use the contact supplied with your invitation.';
+    const hash = document.createElement('p');
+    hash.className = 'checksum'; hash.textContent = `SHA-256: ${release.sha256}`;
+    panel.replaceChildren(heading, detail, notes, download, access, hash);
+  } catch {
+    panel.innerHTML = '<h3>Could not check availability</h3><p>Please try again. No download is offered until its release details can be verified.</p><button type="button" class="button">Try again</button>';
+    panel.querySelector('button')!.addEventListener('click', loadRelease);
+  }
+}
+void loadRelease();
