+    #[test]
+    fn recovery_path_survives_missing_resources_and_study_is_not_a_file() {
+        let f = Fixture::new();
+        let file = f.0.join("not-a-folder");
+        fs::write(&file, "personal test content").unwrap();
+        assert!(f.1.configure(&file, false).is_err());
+        assert_eq!(fs::read_to_string(&file).unwrap(), "personal test content");
+        let study = f.0.join("study");
+        f.1.configure(&study, true).unwrap();
+        let saved = fs::canonicalize(&study).unwrap();
+        fs::remove_dir_all(&f.1.resources).unwrap();
+        assert_eq!(f.1.recovery_path().unwrap(), Some(saved.clone()));
+        let status = f.1.status();
+        assert!(!status.resources_ok);
+        assert!(!status.ready);
+        assert_eq!(status.study_dir, Some(saved));
+    }
+
+    #[test]
+    fn build_identity_needs_no_installation_or_license() {
+        let info = build_info();
+        assert_eq!(info["version"], env!("CARGO_PKG_VERSION"));
+        assert_eq!(info["distribution"], cfg!(feature = "distribution"));
+        #[cfg(feature = "distribution")]
+        {
+            let (key, id) = wb_license::compiled_issuer();
+            assert_eq!(info["issuer_public_key"], serde_json::json!(key));
+            assert_eq!(info["issuer_key_id"], serde_json::json!(id));
+        }
+        #[cfg(not(feature = "distribution"))]
+        assert!(info["issuer_public_key"].is_null() && info["issuer_key_id"].is_null());
+    }
+
+}
