index 0000000..b9ebfc2
--- /dev/null
+++ b/crates/wb-core/src/runtime.rs
@@ -0,0 +1,287 @@
+//! Customer installation bootstrap. Developer builds keep their existing scratch paths.
+use crate::{Error, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{fs, io::Read, path::{Path, PathBuf}, sync::OnceLock};
+
+static ROOTS: OnceLock<Roots> = OnceLock::new();
+
+#[derive(Clone, Debug)]
+pub struct Roots {
+    pub resources: PathBuf,
+    pub config: PathBuf,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Config { schema_version: u32, study_dir: PathBuf }
+
+#[derive(Serialize)]
+pub struct Status {
+    pub ready: bool,
+    pub resources_ok: bool,
+    pub study_dir: Option<PathBuf>,
+    pub suggested_dir: PathBuf,
+    pub problem: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest { schema_version: u32, app_version: String, files: Vec<Resource> }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Resource { name: String, bytes: u64, sha256: String }
+
+fn bad(message: impl Into<String>) -> Error { Error(message.into()) }
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|b| format!("{b:02x}")).collect() }
+
+/// Side-effect-free package identity, available before resources, setup or activation.
+pub fn build_info() -> serde_json::Value {
+    #[cfg(feature = "distribution")]
+    let (key, id) = wb_license::compiled_issuer();
+    #[cfg(not(feature = "distribution"))]
+    let (key, id): (Option<&str>, Option<&str>) = (None, None);
+    serde_json::json!({"version": env!("CARGO_PKG_VERSION"), "distribution": cfg!(feature = "distribution"), "issuer_key_id": id, "issuer_public_key": key})
+}
+
+pub fn initialize(resources: PathBuf) -> Result<&'static Roots> {
+    // Windows pilot: shared location for GUI and CLI, independent of working directory.
+    let local = std::env::var_os("LOCALAPPDATA").ok_or_else(|| bad("Windows local application data is unavailable."))?;
+    ROOTS.set(Roots { resources, config: PathBuf::from(local).join("bible-workbench-rs").join("installation") })
+        .map_err(|_| bad("Installation paths were already initialized."))?;
+    Ok(ROOTS.get().unwrap())
+}
+
+pub fn roots() -> &'static Roots { ROOTS.get().expect("initialize installation paths before opening the app") }
+#[cfg(feature = "distribution")]
+pub fn licensing() -> wb_license::LocalLicense { wb_license::LocalLicense::new(roots().config.join("licensing")) }
+pub fn require_license() -> Result<()> {
+    #[cfg(feature = "distribution")]
+    {
+        // A permanent certificate is verified once per process; no heartbeat or expiry is introduced.
+        static VERIFIED: OnceLock<()> = OnceLock::new();
+        if VERIFIED.get().is_none() {
+            if ROOTS.get().is_none() { return Err(bad("Installation paths must be initialized before checking activation.")); }
+            licensing().active().map_err(bad)?;
+            let _ = VERIFIED.set(());
+        }
+    }
+    Ok(())
+}
+pub fn resource_path(name: &str) -> PathBuf { roots().resources.join(name) }
+pub fn study_path() -> PathBuf {
+    roots().load_study().ok().flatten().unwrap_or_else(|| roots().config.join("setup-required"))
+}
+
+impl Roots {
+    pub fn validate_resources(&self) -> Result<()> {
+        let manifest: Manifest = serde_json::from_slice(&fs::read(self.resources.join("resources-manifest.json"))?).map_err(|e| bad(e.to_string()))?;
+        if manifest.schema_version != 1 || manifest.app_version != env!("CARGO_PKG_VERSION") {
+            return Err(bad("Installed resource version is incompatible. Reinstall the matching app package."));
+        }
+        let required = ["workbench.db", "dictionary.db"];
+        if manifest.files.len() != required.len() { return Err(bad("Incomplete installed resource inventory.")); }
+        for name in required {
+            let entries: Vec<_> = manifest.files.iter().filter(|f| f.name == name).collect();
+            if entries.len() != 1 { return Err(bad(format!("Missing or duplicate resource: {name}"))); }
+            let entry = entries[0];
+            let base = fs::canonicalize(&self.resources)?;
+            let path = fs::canonicalize(base.join(name))?;
+            if !path.starts_with(&base) { return Err(bad("Installed resource points outside the package.")); }
+            let mut file = fs::File::open(path)?;
+            if entry.bytes == 0 || file.metadata()?.len() != entry.bytes { return Err(bad(format!("Installed resource size mismatch: {name}"))); }
+            let mut hash = Sha256::new();
+            let mut buffer = [0u8; 65536];
+            loop { let n = file.read(&mut buffer)?; if n == 0 { break; } hash.update(&buffer[..n]); }
+            if hex(&hash.finalize()) != entry.sha256 { return Err(bad(format!("Installed resource checksum mismatch: {name}. Repair the installation."))); }
+        }
+        // Check the core read schemas as well as the bytes, without writing either DB.
+        crate::bible::Bible::open(&self.resources.join("workbench.db"))?;
+        crate::dictionary::Dictionary::open(&self.resources.join("dictionary.db"))?.source()?;
+        Ok(())
+    }
+
+    pub fn load_study(&self) -> Result<Option<PathBuf>> {
+        let path = self.config.join("installation.json");
+        let bytes = match fs::read(path) {
+            Ok(bytes) => bytes,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(e) => return Err(e.into()),
+        };
+        let config: Config = serde_json::from_slice(&bytes).map_err(|e| bad(e.to_string()))?;
+        if config.schema_version != 1 || !config.study_dir.is_absolute() { return Err(bad("Invalid installation settings. Choose your study folder again.")); }
+        self.validate_study(&config.study_dir)?;
+        Ok(Some(config.study_dir))
+    }
+
+    fn validate_study(&self, path: &Path) -> Result<()> {
+        crate::store::guard(path)?;
+        let path = fs::canonicalize(path)?;
+        self.validate_location(&path)
+    }
+
+    fn validate_location(&self, path: &Path) -> Result<()> {
+        let resources = fs::canonicalize(&self.resources)?;
+        if path.starts_with(&resources) || resources.starts_with(&path) {
+            return Err(bad("Keep your study folder separate from the installed app resources."));
+        }
+        // The Windows resource directory is <install>/resources. Prevent storing work beside app binaries too.
+        if let Some(install) = resources.parent() {
+            if path.starts_with(install) { return Err(bad("Choose a study folder outside the app installation.")); }
+        }
+        if let Ok(config) = fs::canonicalize(&self.config) {
+            if path.starts_with(&config) || config.starts_with(path) { return Err(bad("Choose a study folder separate from installation settings.")); }
+        }
+        Ok(())
+    }
+
+    /// Recovery stays available even if packaged resources are damaged or missing. This reads only
+    /// the saved absolute path and never opens, creates or rewrites the person's files.
+    pub fn recovery_path(&self) -> Result<Option<PathBuf>> {
+        let bytes = match fs::read(self.config.join("installation.json")) {
+            Ok(bytes) => bytes,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(e) => return Err(e.into()),
+        };
+        let config: Config = serde_json::from_slice(&bytes).map_err(|e| bad(e.to_string()))?;
+        if config.schema_version != 1 || !config.study_dir.is_absolute() {
+            return Err(bad("Invalid installation settings. Locate your study folder using your file manager."));
+        }
+        Ok(Some(config.study_dir))
+    }
+
+    pub fn status(&self) -> Status {
+        let suggested_dir = crate::home().join("Documents").join("Bible Workbench Study");
+        if let Err(e) = self.validate_resources() {
+            return Status { ready: false, resources_ok: false, study_dir: self.recovery_path().ok().flatten(), suggested_dir, problem: Some(format!("{e}")) };
+        }
+        match self.load_study() {
+            Ok(study_dir) => {
+                // Try the same read-only store open used by startup before choosing the reader
+                // window; a location check alone does not establish readiness.
+                let problem = study_dir.as_ref().and_then(|path| crate::store::Store::open(path).err()).map(|e| e.to_string());
+                Status { ready: study_dir.is_some() && problem.is_none(), resources_ok: true, study_dir, suggested_dir, problem }
+            },
+            Err(e) => Status { ready: false, resources_ok: true, study_dir: self.recovery_path().ok().flatten(), suggested_dir, problem: Some(format!("{e}")) },
+        }
+    }
+
+    pub fn configure(&self, path: &Path, create: bool) -> Result<()> {
+        self.validate_resources()?;
+        if !path.is_absolute() { return Err(bad("Choose an absolute study folder path.")); }
+        if create {
+            let parent = fs::canonicalize(path.parent().ok_or_else(|| bad("Choose a folder inside an existing parent."))?)?;
+            let candidate = parent.join(path.file_name().ok_or_else(|| bad("Choose a named study folder."))?);
+            self.validate_location(&candidate)?;
+            // A new workspace must really be new. Never reinterpret an existing folder as an empty study.
+            fs::create_dir(path).map_err(|e| bad(format!("Could not create a new study folder: {e}. Its parent must exist and the folder must be new.")))?;
+        }
+        self.validate_study(path)?;
+        let study_dir = fs::canonicalize(path)?;
+        fs::create_dir_all(&self.config)?;
+        let config = Config { schema_version: 1, study_dir };
+        crate::store::write_atomic(&self.config.join("installation.json"), &serde_json::to_string_pretty(&config).map_err(|e| bad(e.to_string()))?)
+    }
+}
+
+#[cfg(test)]
