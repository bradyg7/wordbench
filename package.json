{
  "name": "bible-workbench-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc -p ui && vite build --config ui/vite.config.ts",
    "tauri": "tauri",
    "fixtures": "node scripts/fixtures.mjs",
    "tokens:check": "python scripts/tokens.py --check",
    "ratchet": "node scripts/ratchet.mjs",
    "test:ratchet": "node --test scripts/ratchet.test.mjs",
    "scripture": "node --no-warnings scripts/scripture-check.mjs",
    "test:scripture": "node --no-warnings --test scripts/scripture-check.test.mjs",
    "test:tokens": "node --test scripts/tokens.test.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test ui/unit/*.test.ts",
    "test:commands-cases": "node --test scripts/commands-cases.test.mjs",
    "test:webkit": "playwright test",
    "shots": "node scripts/shots-run.mjs",
    "measure": "node measure/measure.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "tsc -p site && vite build --config site/vite.config.ts",
    "release:check": "node scripts/release/check.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "test:distribution": "node --test scripts/release/tests/*.test.mjs",
    "test:setup": "playwright test --config ui/setup.playwright.config.ts",
    "test:site": "playwright test --config site/playwright.config.ts",
    "package": "node scripts/package.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.2.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "version": "0.1.0"
}
