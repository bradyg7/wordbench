{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible Workbench",
  "version": "0.2.2",
  "identifier": "app.bibleworkbench.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
